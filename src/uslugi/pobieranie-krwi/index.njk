<div class="container prose">
  <section aria-labelledby="kiedy">
    <h2 id="kiedy">Kiedy i gdzie</h2>
    <div class="box box--info">
      <p><strong>Godziny pobrań:</strong> {{ clinic.hours.pobrania.days | daysLabel }}, {{ clinic.hours.pobrania | timeRange }}{% if clinic.hours.pobrania.note %} ({{ clinic.hours.pobrania.note }}){% endif %}.</p>
      <p><strong>Miejsce:</strong> gabinet zabiegowy, {{ clinic.address.street }}, {{ clinic.address.floor }}.</p>
      <p><strong>Telefon:</strong> <a href="tel:{{ clinic.phones.zabiegowy.e164 }}">{{ clinic.phones.zabiegowy.display }}</a></p>
