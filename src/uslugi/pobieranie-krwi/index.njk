<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "MedicalClinic", "@id": {{ (clinic.url + "/#przychodnia") | json | safe }}, "name": {{ clinic.schemaName | json | safe }}, "availableService": { "@type": "MedicalTest", "name": "Pobieranie krwi do badań laboratoryjnych", "url": {{ (page.url | absUrl(clinic.url)) | json | safe }}, "usedToDiagnose": "Badania laboratoryjne zlecone przez lekarza POZ" } }
