{%- from "macros.njk" import faqList, emergencyBox -%}
{#- Kolejność tematów: najpierw topicOrder, potem pozostałe pliki z src/_data/faq/ (alfabetycznie). -#}
{%- set topics = [] -%}
{%- for t in topicOrder %}{% if faq[t] and faq[t].length %}{% set _ = topics.push(t) %}{% endif %}{% endfor -%}
{%- for t, items in faq %}{% if not (t in topicOrder) and items.length %}{% set _ = topics.push(t) %}{% endif %}{% endfor -%}
{%- set questions = [] -%}
{%- for t in topics %}{% for q in faq[t] %}{% set _ = questions.push({ "@type": "Question", "name": q.q, "acceptedAnswer": { "@type": "Answer", "text": (q.a | striptags) } }) %}{% endfor %}{% endfor -%}
<script type="application/ld+json">
{{ { "@context": "https://schema.org", "@type": "FAQPage", "url": (page.url | absUrl(clinic.url)), "inLanguage": "pl", "mainEntity": questions } | json | safe }}
</script>
<div class="container prose">
  <nav aria-labelledby="spis">
    <h2 id="spis">Tematy</h2>
    <ul>
      {%- for t in topics %}
      <li><a href="#temat-{{ t }}">{{ topicNames[t] or ("[DO UZUPEŁNIENIA: nazwa tematu " + t + " w topicNames]") }}</a></li>
      {%- endfor %}
    </ul>
  </nav>

  {%- for t in topics %}
  <section aria-labelledby="temat-{{ t }}">
    <h2 id="temat-{{ t }}">{{ topicNames[t] or ("[DO UZUPEŁNIENIA: nazwa tematu " + t + " w topicNames]") }}</h2>
    {{ faqList(faq[t]) }}
  </section>
  {%- endfor %}

  {{ emergencyBox() }}
</div>
