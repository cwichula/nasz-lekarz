{#- Wspólne komponenty. Import: {% from "macros.njk" import phoneCard, hoursTable %} -#}

{#- Karta telefonu – cała karta jest linkiem tel:. range = godziny linii (days/from/to) → plakietka „odbiera teraz” (JS) -#}
{% macro phoneCard(p, main=false, headingLevel=3, range=null) %}
<a class="phone-card{% if main %} phone-card--main{% endif %}" href="tel:{{ p.e164 }}">
  <span class="phone-card__top">
    <span class="phone-card__label">{{ p.label }}</span>
    {%- if range %}<span class="chip phone-card__state" data-range data-from="{{ range.from }}" data-to="{{ range.to }}" data-l-now="Odbiera teraz" data-l-later="Teraz nie odbiera" data-l-done="Teraz nie odbiera" data-l-off="Teraz nie odbiera" hidden></span>{% endif %}
  </span>
  <span class="phone-card__purpose">{{ p.purpose }}</span>
  <span class="phone-card__bottom">
    <span class="phone-card__numbox">
      <span class="phone-card__number">{{ p.display }}</span>
      <span class="phone-card__hours">{{ p.hoursText }}</span>
    </span>
    <span class="phone-card__call" aria-hidden="true"><svg class="icon" focusable="false"><use href="#i-phone-fill"></use></svg></span>
  </span>
  <span class="visually-hidden">{{ p.callLabel }}</span>
</a>
{% endmacro %}

{#- Trzy telefony: rejestracja jako główny; hours = clinic.hours → plakietka „odbiera teraz” przy rejestracji -#}
{% macro phoneCards(phones, hours=null) %}
<div class="phones">
  {{ phoneCard(phones.rejestracja, true, 3, hours.rejestracja if hours else null) }}
  {{ phoneCard(phones.zabiegowy) }}
  {{ phoneCard(phones.biuro) }}
</div>
{% endmacro %}

{#- Status rejestracji (wypełniany przez JS; bez JS ukryty) -#}
{% macro status(hours, what="Rejestracja", until="") %}
<p class="status" data-status data-what="{{ what }}" data-from="{{ hours.from }}" data-to="{{ hours.to }}"{% if until %} data-until="{{ until }}"{% endif %} hidden><span data-status-text>{{ what }}</span></p>
{% endmacro %}

{#- Tabela godzin tygodniowych: działy w kolumnach, dni w wierszach -#}
{% macro hoursTable(clinic, team, caption="Godziny pracy przychodni", withDoctors=true) %}
<div class="table-wrap">
<table class="hours">
  <caption>{{ caption }}</caption>
  <thead>
    <tr>
      <th scope="col">Dzień</th>
      <th scope="col">Przychodnia</th>
      <th scope="col">Rejestracja</th>
      <th scope="col">Pobieranie krwi</th>
      {%- if withDoctors %}<th scope="col">Lekarze</th>{% endif %}
    </tr>
  </thead>
  <tbody>
    {%- for d in [1, 2, 3, 4, 5] %}
    <tr data-day="{{ d }}">
      <th scope="row">{{ d | dayName | capitalize }}<span class="today-label" data-today-label hidden>dziś</span></th>
      <td data-label="Przychodnia">{{ clinic.hours.przychodnia | timeRange }}</td>
      <td data-label="Rejestracja">{{ clinic.hours.rejestracja | timeRange }}</td>
      <td data-label="Pobieranie krwi">{{ clinic.hours.pobrania | timeRange }}</td>
      {%- if withDoctors %}
      <td data-label="Lekarze">
        <span>{%- set docs = team.doctors | doctorsOn(d) %}
        {%- for x in docs %}<span class="nowrap">{{ x.name }}: {{ x.hours }}</span>{% if not loop.last %}<br>{% endif %}{% else %}<span class="muted">brak przyjęć lekarza</span>{% endfor %}</span>
      </td>
      {%- endif %}
    </tr>
    {%- endfor %}
    <tr data-day="6"><th scope="row">Sobota<span class="today-label" data-today-label hidden>dziś</span></th><td colspan="{{ 4 if withDoctors else 3 }}">nieczynne</td></tr>
    <tr data-day="0"><th scope="row">Niedziela i święta<span class="today-label" data-today-label hidden>dziś</span></th><td colspan="{{ 4 if withDoctors else 3 }}">nieczynne – <a href="/po-godzinach/">gdzie szukać pomocy</a></td></tr>
  </tbody>
</table>
</div>
{%- if clinic.hours.pobrania.note %}<p class="note">Pobieranie krwi: {{ clinic.hours.pobrania.note }}.</p>{% endif %}
{% endmacro %}

{#- Skrócona lista godzin -#}
{% macro hoursList(clinic) %}
<ul class="hours-list">
  {%- for key in ["przychodnia", "rejestracja", "pobrania"] %}
  {%- set h = clinic.hours[key] %}
  <li><span>{{ h.label }}</span><strong>{{ h.days | daysLabel(true) }} {{ h | timeRange }}</strong></li>
  {%- endfor %}
</ul>
{% endmacro %}

{#- Ramka „Gdy jesteśmy zamknięci” -#}
{% macro closedBox(clinic, headingLevel=2) %}
<div class="box box--closed">
  <h{{ headingLevel }} class="box__title"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-moon"></use></svg>Gdy przychodnia jest zamknięta</h{{ headingLevel }}>
  <p>W dni robocze od {{ clinic.hours.przychodnia.to | hm }} do {{ clinic.hours.przychodnia.from | hm }} rano, w weekendy i święta skorzystaj z <strong>nocnej i świątecznej opieki zdrowotnej</strong> – bez skierowania i bez rejestracji. <a href="/po-godzinach/">Adres i godziny punktu w Jeleniej Górze</a>.</p>
  <ul>
    {%- for h in clinic.helplines %}
    <li>{{ h.label }}: <a href="tel:{{ h.e164 }}"><strong>{{ h.display }}</strong></a> ({{ h.hours }})</li>
    {%- endfor %}
  </ul>
  <p><strong>Zagrożenie życia?</strong> Dzwoń pod <a href="tel:112"><strong>112</strong></a> lub <a href="tel:999"><strong>999</strong></a>.</p>
</div>
{% endmacro %}

{#- Ramka alarmowa -#}
{% macro emergencyBox(text="Nagły ból w klatce piersiowej, duszność, utrata przytomności, objawy udaru? Nie czekaj na wizytę.") %}
<div class="box box--emergency" role="note">
  <h2><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-alert"></use></svg>Zagrożenie życia – dzwoń 112</h2>
  <p>{{ text }}</p>
  <div class="btn-row">
    <a class="btn btn--danger" href="tel:112">Zadzwoń 112</a>
    <a class="btn btn--danger" href="tel:999">Zadzwoń 999</a>
  </div>
</div>
{% endmacro %}

{#- Okruszki -#}
{% macro breadcrumbs(items, current) %}
<nav class="breadcrumbs" aria-label="Jesteś tutaj">
  <ol>
    {%- for c in items %}
    <li><a href="{{ c.url }}">{{ c.name }}</a></li>
    {%- endfor %}
    <li><span aria-current="page">{{ current }}</span></li>
  </ol>
</nav>
{% endmacro %}

{#- Kafelek zadania -#}
{% macro tile(url, icon, title, desc) %}
<li><a class="tile" href="{{ url }}">
  <span class="tile__icon"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-{{ icon }}"></use></svg></span>
  <span class="tile__body"><span class="tile__title">{{ title }}</span><span class="tile__desc">{{ desc }}</span></span>
  <svg class="icon icon--sm tile__arrow" aria-hidden="true" focusable="false"><use href="#i-chevron-right"></use></svg>
</a></li>
{% endmacro %}

{#- Karta osoby: godziny przyjęć tekstem, tydzień pn–pt (wizualnie) i plakietka „przyjmuje teraz” (JS) -#}
{% macro personCard(doc, headingLevel=3) %}
<article class="person" id="{{ doc.slug }}">
  <div class="person__head">
    <div class="person__avatar">
      {%- if doc.photo %}<img src="{{ doc.photo }}" alt="{{ doc.title }} {{ doc.name }}" width="72" height="72" loading="lazy">
      {%- else %}<span aria-hidden="true">{% for part in doc.name.split(" ") %}{{ part | first }}{% endfor %}</span>{% endif %}
    </div>
    <div class="person__id">
      <h{{ headingLevel }} class="person__name">{{ doc.title }} {{ doc.name }}</h{{ headingLevel }}>
      <p class="person__role">{{ doc.role }}{% if doc.specialty %}, {{ doc.specialty }}{% endif %}{% if doc.pwz %} · nr PWZ {{ doc.pwz }}{% endif %}</p>
    </div>
    {%- if doc.schedule %}
    <span class="chip person__state" data-schedule="{{ doc.schedule | json }}" data-l-now="Przyjmuje teraz" data-l-later="Dziś od {from}" data-l-done="Dziś już nie przyjmuje" data-l-off="Dziś nie przyjmuje" hidden></span>
    {%- endif %}
  </div>
  {%- if doc.schedule %}
  <dl class="person__hours">
    <dt>Godziny przyjęć</dt>
    {%- for s in doc.schedule %}
    <dd>{{ s.days | daysLabel }}: {{ s | timeRange }}</dd>
    {%- endfor %}
  </dl>
  <ul class="week" aria-hidden="true">
    {%- for d in [1, 2, 3, 4, 5] %}
    {%- set h = doc.schedule | hoursOn(d) %}
    <li class="week__day{% if h %} is-on{% endif %}" data-day="{{ d }}"><span class="week__name">{{ ["", "pn", "wt", "śr", "cz", "pt"][d] }}</span><span class="week__hours">{{ (h | replace(":00", "")) if h else "—" }}</span></li>
    {%- endfor %}
  </ul>
  {%- endif %}
</article>
{% endmacro %}

{#- Blok „Masz pytanie? Zadzwoń” na końcu podstrony -#}
{% macro cta(p, text) %}
<section class="cta" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div>
      <h2 id="cta-title">{{ text or "Masz pytanie? Zadzwoń do nas" }}</h2>
      <p>{{ p.label }}: {{ p.hoursText }}</p>
    </div>
    <a class="btn" href="tel:{{ p.e164 }}"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-phone"></use></svg>{{ p.label }}: {{ p.display }}</a>
  </div>
</section>
{% endmacro %}

{#- Link do pliku -#}
{% macro download(url, name, meta) %}
<li><a class="download" href="{{ url }}"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-download"></use></svg><span>{{ name }}<span class="download__meta">{{ meta }}</span></span></a></li>
{% endmacro %}

{#- FAQ z faq.json – items: lista pytań -#}
{% macro faqList(items) %}
<div class="faq">
  {%- for q in items %}
  <details id="{{ q.id }}">
    <summary>{{ q.q }}</summary>
    <div class="faq__answer"><p>{{ q.a | safe }}</p>{% if q.link %}<p><a href="{{ q.link.url }}">{{ q.link.text }}</a></p>{% endif %}</div>
  </details>
  {%- endfor %}
</div>
{% endmacro %}

{#- Wyraźna informacja: adres, piętro, podnośnik -#}
{% macro whereBox(clinic) %}
<div class="where">
  <p class="where__line"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-map-pin"></use></svg><span><strong>{{ clinic.address.street }}</strong>, <span class="nowrap">{{ clinic.address.postalCode }} {{ clinic.address.city }}</span></span></p>
  <p class="where__line"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-home"></use></svg><span>Przychodnia jest na <strong>{{ clinic.address.floorLocative }}</strong></span></p>
  {%- if clinic.access.lift %}
  <p class="where__line"><svg class="icon" aria-hidden="true" focusable="false"><use href="#i-check"></use></svg><span><strong>{{ clinic.access.liftLabel }}</strong> – dla osób na wózku i tych, którym trudno wejść po schodach</span></p>
  {%- endif %}
</div>
{% endmacro %}

{#- Karta stanu: co można zrobić TERAZ. Bez JS – stałe godziny i numer; JS pokazuje jeden z 5 trybów (assets/js/clinic-state.js) -#}
{% macro statusCard(clinic) %}
{%- set reg = clinic.hours.rejestracja %}{% set cl = clinic.hours.przychodnia %}{% set r = clinic.phones.rejestracja %}{% set z = clinic.phones.zabiegowy %}{% set tele = clinic.helplines[0] %}
<section class="state" data-state data-reg-from="{{ reg.from }}" data-reg-to="{{ reg.to }}" data-clinic-from="{{ cl.from }}" data-clinic-to="{{ cl.to }}" aria-labelledby="state-title">
  <h2 id="state-title" class="visually-hidden">Czy teraz odbieramy telefon?</h2>
  <svg class="state__ring" viewBox="0 0 64 64" aria-hidden="true" focusable="false"><circle cx="32" cy="32" r="26"></circle><circle class="state__ring-value" cx="32" cy="32" r="26"></circle></svg>

  <div class="state__panel state__static">
    <p class="chip">{{ r.label }}</p>
    <p class="state__head">{{ reg.days | daysLabel(true) }} {{ reg | timeRange }}</p>
    <p class="state__sub">Przychodnia {{ cl.days | daysLabel(true) }} {{ cl | timeRange }}</p>
    <div class="btn-row"><a class="btn" href="tel:{{ r.e164 }}">{% icon "phone-fill" %}Zadzwoń {{ r.display }}</a></div>
  </div>

  <div class="state__live" aria-live="polite">
    <div class="state__panel" data-mode-panel="before" hidden>
      <p class="chip">Rejestracja jeszcze nie odbiera</p>
      <p class="state__head">Rejestracja od {{ reg.from | hm }}</p>
      <p class="state__sub">za <span data-countdown="reg-from"></span> · pobieranie krwi od {{ clinic.hours.pobrania.from | hm }}</p>
      <div class="btn-row"><a class="btn" href="tel:{{ r.e164 }}">{% icon "phone-fill" %}Rejestracja {{ r.display }}</a><a class="btn btn--soft" href="/uslugi/pobieranie-krwi/">Pobieranie krwi</a></div>
    </div>
    <div class="state__panel" data-mode-panel="open" hidden>
      <p class="chip">Rejestracja odbiera</p>
      <p class="state__head">Odbieramy teraz</p>
      <p class="state__sub">jeszcze <span data-countdown="reg-to"></span> – do {{ reg.to | hm }}</p>
      <div class="btn-row"><a class="btn" href="tel:{{ r.e164 }}">{% icon "phone-fill" %}Zadzwoń {{ r.display }}</a><a class="btn btn--soft" href="/jak-sie-zapisac/">Jak się zapisać</a></div>
    </div>
    <div class="state__panel" data-mode-panel="soon" hidden>
      <p class="chip">Rejestracja zamyka się wkrótce</p>
      <p class="state__head">Odbieramy jeszcze</p>
      <p class="state__sub">rejestracja zamyka się za <span data-countdown="reg-to"></span></p>
      <div class="btn-row"><a class="btn" href="tel:{{ r.e164 }}">{% icon "phone-fill" %}Zadzwoń teraz {{ r.display }}</a></div>
    </div>
    <div class="state__panel" data-mode-panel="clinic" hidden>
      <p class="chip">Rejestracja już nie odbiera</p>
      <p class="state__head">Lekarz przyjmuje do {{ cl.to | hm }}</p>
      <p class="state__sub">Przyjdź bez zapisu – zapytamy lekarza, czy przyjmie Cię jeszcze dziś.</p>
      <div class="btn-row"><a class="btn" href="tel:{{ z.e164 }}">{% icon "phone-fill" %}{{ z.label }} {{ z.display }}</a><a class="btn btn--soft" href="#dojazd">Gdzie jesteśmy</a></div>
    </div>
    <div class="state__panel" data-mode-panel="after" hidden>
      <p class="chip">Po godzinach</p>
      <p class="state__head">Przychodnia zamknięta</p>
      <p class="state__sub">Otwieramy <span data-next-open></span> o {{ cl.from | hm }} · rejestracja od {{ reg.from | hm }}</p>
      <div class="btn-row"><a class="btn" href="/po-godzinach/">{% icon "moon" %}Pomoc nocna – {{ clinic.nightCare.addressShort }}</a><a class="btn btn--soft" href="tel:{{ tele.e164 }}">Teleporada {{ tele.display }}</a><a class="btn btn--soft btn--alarm" href="tel:112">112</a></div>
    </div>
  </div>

  <dl class="state__hours">
    <div><dt>Rejestracja</dt><dd>{{ reg.days | daysLabel(true) }} {{ reg | timeRange }}</dd></div>
    <div><dt>Przychodnia</dt><dd>{{ cl.days | daysLabel(true) }} {{ cl | timeRange }}</dd></div>
    <div><dt>{{ clinic.hours.pobrania.label }}</dt><dd>{{ clinic.hours.pobrania.days | daysLabel(true) }} {{ clinic.hours.pobrania | timeRange }}</dd></div>
  </dl>
</section>
{% endmacro %}

{#- „Dziś w przychodni”: JS zostawia pozycje z dzisiejszym dniem w data-days. Bez JS – przyjęcia lekarzy w tygodniu. -#}
{% macro todayCard(clinic, team) %}
<section class="today" data-today aria-labelledby="today-title">
  <p class="today__day" data-today-name hidden></p>
  <h2 id="today-title" class="today__title">Dziś w przychodni</h2>
  <ul class="today__list today__live" hidden>
    {%- for doc in team.doctors %}{% for s in doc.schedule %}
    <li data-days="{{ s.days | join(',') }}"><span><span class="today__what">{{ doc.title }} {{ doc.name }}</span><span class="today__when">{{ s | timeRange }}</span></span><span class="chip" data-range data-from="{{ s.from }}" data-to="{{ s.to }}" data-l-now="Przyjmuje" data-l-later="Od {from}" data-l-done="Już nie" hidden></span></li>
    {%- endfor %}{% endfor %}
    {%- for key in ["pobrania", "przychodnia"] %}{% set h = clinic.hours[key] %}
    <li data-days="{{ h.days | join(',') }}"><span><span class="today__what">{{ h.label }}</span><span class="today__when">{{ h | timeRange }}</span></span><span class="chip" data-range data-from="{{ h.from }}" data-to="{{ h.to }}" data-l-now="{{ 'Trwa' if key == 'pobrania' else 'Otwarta' }}" data-l-later="Od {from}" data-l-done="{{ 'Już nie' if key == 'pobrania' else 'Zamknięta' }}" hidden></span></li>
    {%- endfor %}
  </ul>
  <p class="today__closed" data-today-closed hidden>Dziś przychodnia jest nieczynna. {{ clinic.hoursNote }}</p>
  <ul class="today__list today__fallback">
    {%- for doc in team.doctors %}{% for s in doc.schedule %}
    <li><span><span class="today__what">{{ doc.title }} {{ doc.name }}</span><span class="today__when">{{ s.days | daysLabel(true) }} {{ s | timeRange }}</span></span></li>
    {%- endfor %}{% endfor %}
  </ul>
  <a class="today__more" href="/zespol/">Grafik i cały zespół</a>
</section>
{% endmacro %}

{#- Tydzień tekstem: każdy dzień roboczy – rejestracja i przyjęcia lekarzy; dzisiejszy dzień wyróżniony (JS) -#}
{% macro weekSchedule(clinic, team) %}
<ul class="weeklist">
  {%- for d in [1, 2, 3, 4, 5] %}
  <li class="weeklist__day" data-day="{{ d }}">
    <span class="weeklist__name">{{ d | dayName | capitalize }}<span class="today-label" data-today-label hidden>dziś</span></span>
    <span class="weeklist__items">
      <span>Rejestracja {{ clinic.hours.rejestracja | timeRange }}</span>
      {%- for x in team.doctors | doctorsOn(d) %}
      <span>{{ x.name }} {{ x.hours }}</span>
      {%- else %}
      <span class="muted">brak przyjęć lekarza</span>
      {%- endfor %}
    </span>
  </li>
  {%- endfor %}
</ul>
{% endmacro %}
